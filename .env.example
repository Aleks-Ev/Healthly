# Copy to .env and change the values: docker compose reads .env automatically.
# Every variable is optional — docker-compose.yml has local defaults.

# PostgreSQL inside Docker
POSTGRES_USER=healthly
POSTGRES_PASSWORD=change-me

# JWT signing key, at least 32 characters (e.g. output of: openssl rand -base64 48)
JWT_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Development = Scalar docs at /scalar + demo accounts; Production = neither
API_ENVIRONMENT=Development

# true = on the next start, recreate the demo accounts' lab history for the last 6 months (set back to false afterwards)
DEMO_RESET_HISTORY=false

# Where the browser opens the site and reaches the API (change both when deploying to a server)
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5097/api

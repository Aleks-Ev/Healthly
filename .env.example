# Copy to .env and change the values: docker compose reads .env automatically.
# Every variable is optional — docker-compose.yml has local defaults.

# PostgreSQL inside Docker
POSTGRES_USER=healthly
POSTGRES_PASSWORD=change-me

# JWT signing key, at least 32 characters (e.g. output of: openssl rand -base64 48)
JWT_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Development = Scalar docs at /scalar + demo accounts; Production = neither
API_ENVIRONMENT=Development

# true = on the next start, recreate the demo accounts' lab history for the last 6 months (set back to false afterwards)
DEMO_RESET_HISTORY=false

# Where the browser opens the site and reaches the API (change both when deploying to a server)
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5097/api
# Empty = the browser calls the API directly (PUBLIC_API_URL above).
# http://api:8080 = the site proxies /api/* to the API, so both live on one address (needed for the tunnel)
API_PROXY_TARGET=

# First administrator, created on start if this email does not exist yet (the only way to get one in Production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Public demo server via Cloudflare Tunnel (TEAM_GUIDE.md, "Публичный демо-сервер"):
#   API_ENVIRONMENT=Production, WEB_ORIGIN=https://<your domain>, PUBLIC_API_URL=/api, API_PROXY_TARGET=http://api:8080
#   start with: docker compose --profile tunnel up -d --build
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel (secret, never commit it)
CLOUDFLARE_TUNNEL_TOKEN=

# AI document analysis (optional; empty = mock). Gemini is used first, Groq when Gemini fails or hits its limits.
# Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

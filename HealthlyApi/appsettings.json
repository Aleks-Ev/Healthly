{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "HealthlyApi",
    "Audience": "healthly-web",
    "Key": "",
    "ExpiresMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "UploadsPath": "uploads"
  },
  "Ai": {
    "TimeoutSeconds": 30,
    "MaxInputChars": 20000,
    "Gemini": { "Model": "gemini-3.5-flash" },
    "Groq": { "Model": "openai/gpt-oss-120b" }
  },
  "Ocr": {
    "TesseractPath": "tesseract",
    "Languages": "eng+tur",
    "FallbackLanguages": "eng+rus+tur",
    "FallbackBelowConfidence": 75,
    "PageSegmentationMode": 6,
    "MinConfidence": 55
  }
}
